# Copy to .env and fill in real values. Never commit .env (gitignored).

# Google Gemini API – Journal AI Insights (free tier via Google AI Studio)
# Get your key at: https://aistudio.google.com/apikey
EXPO_PUBLIC_GEMINI_API_KEY=""

# RevenueCat – subscription/IAP entitlements
# Get keys at: app.revenuecat.com → Project Settings → API Keys
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=""
EXPO_PUBLIC_REVENUECAT_IOS_KEY=""

# Sentry – source maps upload for release builds (Organization Token)
# Create at: sentry.io → Settings → Developer Settings → Organization Tokens
SENTRY_AUTH_TOKEN=""
