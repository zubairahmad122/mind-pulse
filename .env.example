# Copy this file to `.env` in the project root and fill in real values.
# `.env` is gitignored — never commit real keys.
# Restart Metro after creating/editing `.env` (env vars are inlined at bundle time).

# RevenueCat — app.revenuecat.com → Project settings → API keys
EXPO_PUBLIC_REVENUECAT_IOS_KEY=appl_xxxxxxxx
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=goog_xxxxxxxx

# Google Gemini — https://aistudio.google.com/apikey
EXPO_PUBLIC_GEMINI_API_KEY=AIza...
