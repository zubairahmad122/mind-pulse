    "ios": "expo run:ios",
    "build:apk": "bash scripts/build-apk.sh",
    "install:apk": "adb install -r android/app/build/outputs/apk/release/app-release.apk",
    "web": "expo start --web",
    "lint": "expo lint",
    "test": "jest",
    "validate:eye-reminders:android": "bash scripts/validate-eye-reminders-android.sh"
