  "private": true,
  "jest": {
    "preset": "jest-expo",
    "moduleNameMapper": {
      "\\.(mp3|wav)$": "<rootDir>/jest.assets-stub.js",
      "^@/assets/(.*)$": "<rootDir>/assets/$1",
      "^@/(.*)$": "<rootDir>/src/$1"
    },
    "testMatch": [
      "**/__tests__/**/*.test.ts",
      "**/__tests__/**/*.test.tsx"
