<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="expo.modules.mindpulsealarm" >

    <uses-sdk android:minSdkVersion="24" />

    <!--
    SCHEDULE_EXACT_ALARM only — deliberately NOT declaring USE_EXACT_ALARM.
    Play policy (support.google.com/googleplay/android-developer/answer/9888170)
    restricts USE_EXACT_ALARM's auto-grant to apps whose core, user-facing
    function IS an alarm-clock or calendar app; Well Mode is a broad wellness
    app where the wake alarm is one feature among several (Screen Balance,
    Focus, Eye, Relax…), so it does not clearly qualify and declaring it risks
    a Play policy rejection. SCHEDULE_EXACT_ALARM (special access, user-granted
    via Settings — see MindPulseAlarmModule.hasExactAlarm/requestPermissions)
    is the compliant path and is all AlarmScheduler's setAlarmClock() call
    actually needs.
    -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application>
        <receiver
            android:name="expo.modules.mindpulsealarm.AlarmReceiver"
            android:enabled="true"
            android:exported="false" />
        <receiver
            android:name="expo.modules.mindpulsealarm.BootReceiver"
            android:enabled="true"
            android:exported="true" >
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <service
            android:name="expo.modules.mindpulsealarm.AlarmService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <activity
            android:name="expo.modules.mindpulsealarm.AlarmActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTask"
            android:showOnLockScreen="true"
            android:taskAffinity=""
            android:theme="@style/MindPulseAlarmTheme"
            android:turnScreenOn="true" />
    </application>

</manifest>