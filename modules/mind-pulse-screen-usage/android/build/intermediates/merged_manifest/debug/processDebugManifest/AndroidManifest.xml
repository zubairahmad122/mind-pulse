<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="expo.modules.mindpulsescreenusage" >

    <uses-sdk android:minSdkVersion="24" />

    <!--
    Not a runtime-prompt permission — the user must explicitly grant Usage
    Access from Android Settings (see MindPulseScreenUsageModule.openUsageAccessSettings).
    `tools:ignore="ProtectedPermissions"` silences the lint warning that this
    is a signature/privileged permission; declaring it is what makes MindPulse
    show up as a row in the system's Usage Access settings list.
    -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!--
    Normal permission (no runtime prompt, no manual Settings grant needed
    just to declare it) — but actually calling `setInterruptionFilter` still
    requires "Do Not Disturb access", a separate special-access toggle the
    user grants from Settings (see MindPulseScreenUsageModule.openDndAccessSettings).
    Declaring this is what lets the module call `NotificationManager`'s DND
    APIs at all once that access is granted.
    -->
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />

    <!--
    Android 11+ package-visibility rules hide `PackageManager` lookups
    (app labels, launcher resolution) for packages this app hasn't declared
    a matching <queries> entry for, even though UsageStatsManager itself
    still freely reports their package names in usage events. Without
    these, most "Most Used Today" entries fall back to a raw package id
    instead of a resolved label, and the current launcher can't be
    identified to exclude it from that list.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />

            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />

            <category android:name="android.intent.category.HOME" />
        </intent>
    </queries>

    <application>
        <service
            android:name="expo.modules.mindpulsescreenusage.SmartResetReminderJobService"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.BIND_JOB_SERVICE" />
    </application>

</manifest>